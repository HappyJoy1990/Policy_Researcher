{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scope",
  "type": "object",
  "required": ["input_type", "segments", "regions", "boundary_confidence"],
  "properties": {
    "input_type": { "enum": ["company", "industry"] },
    "entity": {
      "type": "object",
      "properties": {
        "full_name": { "type": "string" },
        "unified_social_credit_code": { "type": "string" },
        "registered_address": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "boundary"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "boundary": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "regions": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "additional": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      }
    },
    "boundary_confidence": { "enum": ["高", "中", "低"] },
    "research_questions": { "type": "array", "items": { "type": "string" } },
    "time_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "metrics_dictionary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "definition", "unit", "data_source_type"],
        "properties": {
          "metric": { "type": "string" },
          "definition": { "type": "string" },
          "unit": { "type": "string" },
          "formula": { "type": "string" },
          "data_source_type": { "type": "string" },
          "limitation": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "source_url": { "type": "string" },
          "verification": { "type": "string" }
        }
      }
    }
  }
}
